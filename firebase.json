{
  "firestore": {
    "database": "ai-studio-ececf2d5-e671-43f3-8f2c-ce258672a8e7",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "focao",
    "public": "dist",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://track-up.vercel.app https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://use.typekit.net; img-src 'self' data: blob: https: https://www.facebook.com; font-src 'self' data: https://fonts.gstatic.com https://use.typekit.net; worker-src 'self' blob:; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasestorage.app https://*.firebaseapp.com https://foc-o.vercel.app https://track-up.vercel.app https://connect.facebook.net https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/ansiedade",
        "destination": "/quiz-ansiedade.html"
      },
      {
        "source": "/quiz-ansiedade",
        "destination": "/quiz-ansiedade.html"
      },
      {
        "source": "/ebook",
        "destination": "/ebook.html"
      },
      {
        "source": "/upsell",
        "destination": "/upsell.html"
      },
      {
        "source": "/obrigado",
        "destination": "/obrigado.html"
      },
      {
        "source": "/vsl-ansiedade",
        "destination": "/vsl-ansiedade.html"
      },
      {
        "source": "/landing",
        "destination": "/focao-landing.html"
      },
      {
        "source": "/ebooks",
        "destination": "/focao-ebooks.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
