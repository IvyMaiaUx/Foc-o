rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasAdminConfig() {
      return exists(/databases/$(database)/documents/adminSettings/auth);
    }

    function adminConfig() {
      return get(/databases/$(database)/documents/adminSettings/auth).data;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && normalizedEmail() in [
          'focaosupport@gmail.com'
        ];
    }

    function isConfiguredAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() || isConfiguredAdmin();
    }

    function isConfiguredSuperAdmin() {
      return signedIn() && request.auth.token.superAdmin == true;
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || isConfiguredSuperAdmin();
    }

    function hasOnlyFreeSubscriptionOnCreate() {
      return (!('subscriptionTier' in request.resource.data) || request.resource.data.subscriptionTier == 'free')
        && (!('trialEndsAt' in request.resource.data) || request.resource.data.trialEndsAt == 0)
        && (!('subscription' in request.resource.data) || (
          request.resource.data.subscription.plan == 'free'
          && request.resource.data.subscription.status == 'inactive'
          && request.resource.data.subscription.premiumAccess == false
        ));
    }

    function isWritingProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscription',
        'subscriptionTier',
        'trialEndsAt',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'uid',
        'email',
        'createdAt',
        'referralCode',
        'referredBy',
        'referredById',
        'referralRewardsDays',
        'validReferrals',
        'referralsLimitReached',
        'premiumBonusDays',
        'premiumBonusExpiresAt',
        'role',
        'admin',
        'isAdmin'
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && hasOnlyFreeSubscriptionOnCreate();
      allow update: if (isOwner(uid) && !isWritingProtectedUserFields()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{uid}/dog/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/dogs/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/plan/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/evolution/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/adminReports/{document=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid}/checkins/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/missions/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/dailyCheckins/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/trainingLogs/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/trainingSessions/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/sessions/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/trainingHistory/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/completedTrainings/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/vaccines/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/notifications/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/customEvents/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/customEventCompletions/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /adminSettings/productConfig {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /adminSettings/{document=**} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    function isValidAnalyticsEventCreate(eventId) {
      return signedIn()
        && eventId.size() <= 160
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'event',
          'timestamp',
          'metadata'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.event in [
          'session_started',
          'onboarding_started',
          'onboarding_completed',
          'training_started',
          'training_completed',
          'checkin_created',
          'report_viewed',
          'premium_viewed',
          'premium_clicked',
          'premium_subscribed',
          'premium_cancelled'
        ]
        && request.resource.data.timestamp is number
        && (!('metadata' in request.resource.data) || request.resource.data.metadata is map);
    }

    match /analytics_events/{eventId} {
      allow create: if isValidAnalyticsEventCreate(eventId);
      allow read, update, delete: if isAdmin();
    }

    match /whatsapp_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /avaliacoes/{reviewId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /cancellations/{cancellationId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    function isValidMarketingLeadCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'whatsapp',
          'source',
          'status',
          'createdAt',
          'updatedAt',
          'page',
          'userAgent'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 120
        && (!('whatsapp' in request.resource.data) || (
          request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() <= 32
        ))
        && (!('page' in request.resource.data) || (
          request.resource.data.page is string
          && request.resource.data.page.size() <= 120
        ))
        && (!('userAgent' in request.resource.data) || (
          request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 180
        ))
        && request.resource.data.source in ['ebook', 'landing_ebook']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /marketingLeads/{leadId} {
      allow create: if isValidMarketingLeadCreate();
      allow read, update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if signedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /supportThreads/{document=**} {
      allow read, write: if isAdmin();
    }

    match /supportThreads/{uid} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /supportThreads/{uid}/messages/{messageId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.sender == 'user');
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.type == 'global' ||
        resource.data.targetUid == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    match /nutritionFormulas/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
